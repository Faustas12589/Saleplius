@inject CustomAuthStateProvider Auth

@{
    var mine = Auth.Owns(Workout.CreatedByUserId);
}
<div class="card card-link-hover h-100 @(mine ? "mine" : "")">
    <div class="card-body d-flex flex-column">
        <div class="d-flex justify-content-between align-items-start gap-3 mb-1">
            <h3 class="h6 fw-bold mb-0 lh-sm">
                <a href="@Href" class="title-link stretched-link">@Workout.Title</a>
            </h3>
            <span class="rating">
                @if (Workout.RatingsCount > 0)
                {
                    <span class="star">★</span> @Workout.AverageRating.ToString("0.0") <small>(@Workout.RatingsCount)</small>
                }
                else
                {
                    <small>Neįvertinta</small>
                }
            </span>
        </div>

        <div class="meta mb-2">
            @if (mine)
            {
                <span class="badge badge-mine">Mano</span>
            }
            else
            {
                <span>@Workout.CreatedByUserName</span>
            }
            <span class="dot">@Workout.Exercises.Count prat.</span>
            <span class="dot">@DifficultyLt(Workout.Difficulty)</span>
        </div>

        @if (ShowDescription && !string.IsNullOrWhiteSpace(Workout.Description))
        {
            <p class="small text-secondary mb-3 clamp-2">@Workout.Description</p>
        }

        @if (Workout.TargetMuscleGroups.Count > 0)
        {
            <div class="d-flex flex-wrap gap-1 mt-auto">
                @foreach (var m in Workout.TargetMuscleGroups)
                {
                    <span class="chip">@m</span>
                }
            </div>
        }
    </div>
    @if (Actions != null)
    {
        <div class="card-footer d-flex flex-wrap gap-2 py-2 position-relative" style="z-index: 2;">
            @Actions
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public Workout Workout { get; set; } = default!;
    [Parameter] public bool ShowDescription { get; set; } = true;
    [Parameter] public RenderFragment? Actions { get; set; }

    /// <summary>Workouts that belong to a program open at their place in the hierarchy.</summary>
    private string Href => string.IsNullOrEmpty(Workout.ProgramId)
        ? $"workouts/{Workout.Id}"
        : $"programs/{Workout.ProgramId}/workouts/{Workout.Id}";

    public static string DifficultyLt(string? d) => d switch
    {
        "Beginner" => "Pradedantiesiems",
        "Intermediate" => "Vidutinis",
        "Advanced" => "Pažengusiems",
        _ => d ?? ""
    };
}
