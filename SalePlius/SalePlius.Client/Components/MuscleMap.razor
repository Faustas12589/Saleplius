    {
        "M62 252 C66 250 72 250 75 254 C74 259 70 261 66 261 C63 259 62 256 62 252 Z", // kneecap
    },
    Details: new[]
    {
        "M52 78 C60 82 70 86 78 90",      // chest fibres
        "M50 88 C58 92 68 96 77 100",
        "M42 70 C40 80 38 90 36 98",      // front / side shoulder split
        "M37 110 C37 117 37 124 38 128", // biceps peak
        "M26 196 L26 206 M29 199 L29 209 M32 199 L32 207", // fingers
        "M58 200 C59 214 60 228 61 240", // quad lines
        "M68 196 C68 212 69 228 70 242",
        "M58 272 C58 288 59 300 60 310", // shin
    },
    SkinLines: new[]
    {
        "M73 46 C75 49 78 50 80 50",      // jaw line
        "M74 55 C74 58 73 61 71 63",      // neck muscle
    });

    private static readonly View Back = new("Nugara", 170, new Region[]
    {
        new("Trapecinis", new[] { "M80 50 C76 54 68 60 56 63 C62 70 70 84 80 108 Z" }),
        new("Platieji nugaros", new[]
        {
            "M58 68 C53 74 52 84 54 92 L68 88 C66 80 63 72 58 68 Z",                     // shoulder blade
            "M52 96 C50 112 53 128 62 142 L79 150 L79 112 C72 106 62 100 52 96 Z",       // lats
        }),
