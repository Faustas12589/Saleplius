            "M64 178 C61 200 61 224 63 246 C67 253 73 253 75 247 C76 226 76 204 73 186 Z",  // middle
            "M74 228 C78 234 78 244 75 252 C71 254 69 251 70 247 C73 242 74 236 74 228 Z",  // teardrop
        }),
