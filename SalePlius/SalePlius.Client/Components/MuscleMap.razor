@implements IDisposable
@*
    Body map (front + back) drawn as inline SVG, one shape group per muscle category.
    Interactive: click (or Tab + Enter/Space) a muscle to toggle it as a filter.
    Primary/Secondary: what the page is about (always shown).
    Hover: the card or row under the mouse (shown instead, while set).
*@

<div class="muscle-map @(Interactive ? "interactive" : "readonly") @(Pulse && Hovering ? "pulsing" : "")">
    <svg viewBox="0 0 340 356" style="max-width: @(MaxWidth)px" role="@(Interactive ? "group" : "img")" aria-label="@AriaLabel">
        @{ var state = States(); }
        @foreach (var view in Views)
        {
            <g transform="translate(@view.OffsetX 0)">
                <ellipse class="shadow" cx="80" cy="343" rx="46" ry="5" />

                @* Body and head: outline first, then the fill on top hides the seam where the two halves meet *@
                @foreach (var d in BodyPaths)
                {
                    <path class="skin-outline" d="@d" />
                }
                @foreach (var d in BodyPaths)
                {
                    <path class="skin" d="@d" />
                }

                @* Kneecaps and Achilles tendons: drawn, but not muscle groups *@
                @foreach (var d in view.Minor)
                {
                    <path class="minor" d="@d" />
                }

                @foreach (var shape in view.Muscles)
                {
                    if (Interactive)
                    {
                        <path class="muscle @state[shape.Group]" d="@shape.D"
                              tabindex="@(shape.TabStop ? 0 : -1)" role="button"
                              aria-label="@shape.Group" aria-pressed="@(Selected.Contains(shape.Group) ? "true" : "false")"
                              @onclick="() => Toggle(shape.Group)"
                              @onkeydown="e => OnKey(e, shape.Group)"
                              @onfocus="() => hovered = shape.Group"
                              @onblur="() => hovered = null"
                              @onmouseenter="() => hovered = shape.Group"
                              @onmouseleave="() => hovered = null" />
                    }
                    else
                    {
                        <path class="muscle @state[shape.Group]" d="@shape.D" />
                    }
                }

                @foreach (var d in view.Details)
                {
                    <path class="detail" d="@d" />
                }
                @foreach (var d in view.SkinLines)
                {
                    <path class="skin-line" d="@d" />
                }

                <text x="80" y="356" text-anchor="middle" class="view-label">@view.Label</text>
            </g>
        }
    </svg>
</div>

@code {
    /// <summary>Muscle groups chosen as a filter (shown as selected).</summary>
    [Parameter] public IReadOnlyCollection<string> Selected { get; set; } = Array.Empty<string>();

    /// <summary>Main muscles of what the page shows (strong highlight).</summary>
    [Parameter] public IReadOnlyCollection<string> Primary { get; set; } = Array.Empty<string>();

    /// <summary>Secondary muscles of what the page shows (soft highlight).</summary>
    [Parameter] public IReadOnlyCollection<string> Secondary { get; set; } = Array.Empty<string>();

    /// <summary>The card or row under the mouse (see HoverZone); shown instead of Primary/Secondary while set.</summary>
    [Parameter] public MuscleHover? Hover { get; set; }

    [Parameter] public EventCallback<string> OnToggle { get; set; }

    /// <summary>False on detail pages: the map only shows muscles, clicking does nothing.</summary>
    [Parameter] public bool Interactive { get; set; } = true;

    /// <summary>Pulse the main muscles while a hovered card is shown.</summary>
    [Parameter] public bool Pulse { get; set; } = true;

    [Parameter] public int MaxWidth { get; set; } = 440;

    /// <summary>Muscle groups that have a place on the body (category names).</summary>
    public static readonly string[] Groups =
    {
        "Krūtinė", "Priekiniai deltiniai", "Užpakaliniai deltiniai", "Bicepsas", "Tricepsas", "Dilbiai",
        "Pilvo presas", "Įstrižiniai", "Trapecinis", "Platieji nugaros", "Apatinė nugara",
        "Sėdmenys", "Keturgalviai", "Šlaunies dvigalviai", "Pritraukiamieji", "Blauzdos",
    };

    /// <summary>True when the group can be clicked on the body.</summary>
    public static bool IsOnBody(string group) => Groups.Contains(group, StringComparer.OrdinalIgnoreCase);

    private string AriaLabel => Interactive
        ? "Raumenų grupių filtras"
        : Primary.Count == 0 ? "Raumenų žemėlapis" : "Treniruojami raumenys: " + string.Join(", ", Primary.Concat(Secondary));

    private string? hovered;   // muscle under the pointer (filter only): lightly highlighted

    /// <summary>CSS state of every muscle group, worked out once per render (not once per shape).</summary>
    private Dictionary<string, string> States()
    {
        var primary = Hovering ? hoverP : Primary;
        var secondary = Hovering ? hoverS : Secondary;
        var anyShown = primary.Count > 0 || secondary.Count > 0;

        var states = new Dictionary<string, string>(Groups.Length);
        foreach (var group in Groups)
        {
            var css = Selected.Contains(group) ? "selected" : "";
            if (primary.Contains(group)) css += " primary";
            else if (secondary.Contains(group)) css += " secondary";
            else if (anyShown) css += " dim";
            if (group == hovered) css += " hover";
            states[group] = css;
        }
        return states;
    }

    // ---- Hover: comes from MuscleHover, so only this map redraws (not the page) ----
    // Moving the mouse from one card to the next crosses the gap between them. The highlight is released
    // after a short delay, so the body doesn't flash back to plain and light up again on every move.
    private const int ReleaseDelayMs = 300;
    private IReadOnlyCollection<string> hoverP = Array.Empty<string>(), hoverS = Array.Empty<string>();
    private CancellationTokenSource? release;
    private MuscleHover? subscribed;

    private bool Hovering => hoverP.Count > 0 || hoverS.Count > 0;

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(subscribed, Hover)) return;
        if (subscribed != null) subscribed.Changed -= OnHoverChanged;
        subscribed = Hover;
        if (subscribed != null) subscribed.Changed += OnHoverChanged;
    }

    private void OnHoverChanged() => _ = InvokeAsync(() =>
    {
        if (Hover == null) return;
        if (!Hover.IsEmpty)
        {
            release?.Cancel();
            release = null;
            hoverP = Hover.Primary;
            hoverS = Hover.Secondary;
            StateHasChanged();
        }
        else if (Hovering && release == null)
        {
            release = new CancellationTokenSource();
            _ = ReleaseLater(release.Token);
        }
    });

    private async Task ReleaseLater(CancellationToken token)
    {
        try
        {
            await Task.Delay(ReleaseDelayMs, token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        release = null;
        hoverP = hoverS = Array.Empty<string>();
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        release?.Cancel();
        if (subscribed != null) subscribed.Changed -= OnHoverChanged;
    }

    private Task Toggle(string group) => OnToggle.InvokeAsync(group);

    private Task OnKey(KeyboardEventArgs e, string group) =>
        e.Key is "Enter" or " " ? Toggle(group) : Task.CompletedTask;

    private record Region(string Group, string[] Paths);
    private record View(string Label, int OffsetX, Region[] Regions, string[] Minor, string[] Details, string[] SkinLines);

    // What gets rendered: every path already mirrored. Built once when the app starts, never per render.
    private record Shape(string Group, string D, bool TabStop);
    private record ReadyView(string Label, int OffsetX, Shape[] Muscles, string[] Minor, string[] Details, string[] SkinLines);

    // Every shape is drawn for the left half only (x ≤ 80) and mirrored to the right (x → 160 − x).
    // Body and head halves reach x = 80.6 so the two mirrored halves overlap and leave no seam.

    // Head with cranium, ear, jaw and chin.
    private const string Head =
        "M80.6 7 C71 7 65 13 65 23 C65 28 66 31 67 34 C64 34 63 37 64 40 C65 43 67 44 68 43 " +
        "C69 48 72 52 76 54 C78 55 80.6 55 80.6 55 Z";

    // Broad shoulders, V-taper, big arms and legs.
    private const string Silhouette =
        "M80.6 48 L72 48 C71 55 65 60 54 62 C40 64 30 70 28 82 C26 92 26 102 27 110 C27 118 28 126 30 132 " +
        "C25 144 22 158 22 172 C22 180 23 186 25 190 C24 196 24 204 27 210 C30 214 34 212 35 206 " +
        "C36 200 36 194 35 190 C38 178 41 162 43 148 C44 140 44 134 43 130 C45 120 47 108 48 98 " +
        "C49 104 50 112 52 122 C54 132 56 140 58 148 C57 156 54 164 53 172 C48 190 47 214 50 236 " +
        "C51 244 53 250 54 256 C51 270 50 286 53 300 C55 310 57 318 58 324 L57 332 C55 336 55 340 60 340 " +
        "L73 340 C75 338 74 333 72 329 L72 322 C75 306 77 288 76 272 C76 264 76 258 77 252 " +
        "C79 232 80.6 212 80.6 190 Z";

