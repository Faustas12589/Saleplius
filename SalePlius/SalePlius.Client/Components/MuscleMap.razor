        "M37 137 C34 150 32 164 31 177 L34 178 C37 166 41 152 42 139 C41 136 39 135 37 137 Z",
    };

    private static readonly View Front = new("Priekis", 0, new Region[]
    {
        new("Trapecinis", new[] { "M72 52 C71 56 67 60 60 62 L74 64 C75 60 74 56 72 52 Z" }), // seen above the collarbone
        new("Krūtinė", new[] { "M79 66 C70 63 60 63 54 67 C47 74 45 86 47 96 C51 106 64 110 79 107 Z" }),
        new("Priekiniai deltiniai", new[] { Delt }),
        new("Bicepsas", new[] { UpperArm }),
