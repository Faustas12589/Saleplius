        new("Pilvo presas", new[]
        {
            "M79 111 L69 111 C68 115 68 119 69 123 L79 123 Z",
            "M79 126 L69 126 C68 130 68 134 69 138 L79 138 Z",
            "M79 141 L69 141 C68 145 68 149 69 153 L79 153 Z",
            "M79 156 L70 156 C70 164 74 172 79 178 Z",
        }),
        new("Įstrižiniai", new[]
        {
