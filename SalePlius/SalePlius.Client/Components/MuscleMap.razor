        new("Užpakaliniai deltiniai", new[] { Delt }),
        new("Tricepsas", new[] { UpperArm }),
        new("Dilbiai", Forearm),
        new("Sėdmenys", new[] { "M55 176 C50 188 52 204 63 209 C72 211 79 205 79 194 L79 176 C71 173 62 173 55 176 Z" }),
        new("Šlaunies dvigalviai", new[]
        {
            "M54 213 C51 228 52 242 56 254 C60 257 63 255 64 250 C63 238 63 226 64 214 Z",
            "M66 214 C66 228 66 240 67 252 C71 257 75 255 76 250 C77 238 77 226 76 212 Z",
        }),
        new("Blauzdos", new[]
        {
            "M54 262 C49 276 50 294 56 304 C60 307 63 305 64 300 C64 286 64 272 63 262 Z",
            "M65 262 C72 270 76 284 75 298 C73 307 68 307 65 302 C64 288 64 274 65 262 Z",
        }),
    },
    Minor: new[]
    {
        "M63 308 L69 308 L70 324 L64 324 Z", // Achilles tendon
    },
    Details: new[]
    {
        "M34 114 C38 121 42 121 44 113",   // triceps horseshoe
        "M60 112 C65 120 71 128 77 134",   // lat fibres
        "M57 122 C62 130 68 137 75 142",
        "M66 70 C70 78 74 88 78 98",       // traps
        "M58 190 C64 196 72 198 78 197",   // glute line
        "M64 274 C64 284 65 292 65 298",   // calf split
        "M26 196 L26 206 M29 199 L29 209 M32 199 L32 207", // fingers
    },
    SkinLines: Array.Empty<string>());

    private static readonly string[] BodyPaths = Mirror(new[] { Silhouette, Head }).ToArray();
    private static readonly ReadyView[] Views = Prepare(Front, Back);

    private static ReadyView[] Prepare(params View[] views)
    {
        var seen = new HashSet<string>();   // one keyboard stop per muscle group: its first shape
        return views.Select(v => new ReadyView(
            v.Label,
            v.OffsetX,
            v.Regions.SelectMany(r => Mirror(r.Paths).Select(d => new Shape(r.Group, d, seen.Add(r.Group)))).ToArray(),
            Mirror(v.Minor).ToArray(),
            Mirror(v.Details).ToArray(),
            Mirror(v.SkinLines).ToArray())).ToArray();
    }

    /// <summary>Returns each left-side path plus its mirror image.</summary>
    private static IEnumerable<string> Mirror(IEnumerable<string> paths)
    {
        foreach (var d in paths)
        {
            yield return d;
            yield return MirrorPath(d);
        }
    }

    private static string MirrorPath(string d)
    {
        // Coordinates come in "x y" pairs after each command letter; flip every x.
        var inv = System.Globalization.CultureInfo.InvariantCulture;
        var tokens = d.Replace(",", " ").Split(' ', StringSplitOptions.RemoveEmptyEntries);
        var result = new List<string>();
        var command = 'M';
        var index = 0;
        foreach (var t in tokens)
        {
            var number = t;
            if (char.IsLetter(t[0]))
            {
                command = t[0];
                index = 0;
                result.Add(t[..1]);
                if (t.Length == 1) continue;
                number = t[1..];
            }

            var isX = command switch { 'H' => true, 'V' => false, 'Z' => false, _ => index % 2 == 0 };
            var value = double.Parse(number, inv);
            result.Add((isX ? 160 - value : value).ToString(inv));
            index++;
        }
        return string.Join(' ', result);
    }
}
