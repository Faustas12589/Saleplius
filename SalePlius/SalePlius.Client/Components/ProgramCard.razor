@inject CustomAuthStateProvider Auth

@{
    var mine = Auth.Owns(Program.CreatedByUserId);
    var trainingDays = Program.Workouts.Select(w => w.Day).ToHashSet();
}
<div class="card card-link-hover h-100 @(mine ? "mine" : "")">
    <div class="card-body d-flex flex-column">
        <div class="eyebrow mb-1">@Program.Goal</div>
        <h3 class="h6 fw-bold mb-1 lh-sm">
            <a href="programs/@Program.Id" class="title-link stretched-link">@Program.Title</a>
        </h3>

        <div class="meta mb-2">
            @if (mine)
            {
                <span class="badge badge-mine">Mano</span>
            }
            else
            {
                <span>@Program.CreatedByUserName</span>
            }
            <span class="dot">@Text.Plural(Program.DurationWeeks, "savaitė", "savaitės", "savaičių")</span>
            <span class="dot">@WorkoutCard.DifficultyLt(Program.Difficulty)</span>
        </div>

        @if (!string.IsNullOrWhiteSpace(Program.Description))
        {
            <p class="small text-secondary mb-3 clamp-2">@Program.Description</p>
        }

        <div class="week-strip mt-auto" title="Treniruočių dienos">
            @for (var d = 1; d <= 7; d++)
            {
                <span class="@(trainingDays.Contains(d) ? "on" : "")">@ProgramText.DayAbbr(d)</span>
            }
        </div>
    </div>
    @if (Actions != null)
    {
        <div class="card-footer d-flex flex-wrap gap-2 py-2 position-relative" style="z-index: 2;">
            @Actions
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public TrainingProgram Program { get; set; } = default!;
    [Parameter] public RenderFragment? Actions { get; set; }
}
