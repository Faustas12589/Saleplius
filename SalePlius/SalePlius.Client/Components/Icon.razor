@* Small line icons drawn as inline SVG (they take the text colour). *@

<svg class="icon" viewBox="0 0 24 24" width="@Size" height="@Size" aria-hidden="true" focusable="false"
     fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
    @switch (Name)
    {
        case "calendar":   @* Programos *@
            <rect x="3.5" y="5" width="17" height="15.5" rx="2.5" />
            <path d="M8 3v4M16 3v4M3.5 10h17" />
            break;
        case "dumbbell":   @* Treniruotės *@
            <path d="M6.5 7v10M3.5 9.5v5M17.5 7v10M20.5 9.5v5M6.5 12h11" />
            break;
        case "activity":   @* Pratimai *@
            <path d="M3 12h4l2.5-6.5 5 13L17 12h4" />
            break;
        case "bookmark":   @* Išsaugoti *@
            <path d="M6.5 3.5h11v17l-5.5-4-5.5 4z" />
            break;
        case "flag":       @* Pranešimai *@
            <path d="M5 21V4M5 4h11.5l-2 4 2 4H5" />
            break;
        case "users":      @* Vartotojai *@
            <circle cx="9" cy="8" r="3.5" />
            <path d="M2.5 20c.8-3.5 3.4-5.5 6.5-5.5s5.7 2 6.5 5.5M16 4.6a3.5 3.5 0 0 1 0 6.8M18 14.6c2 .7 3.2 2.6 3.5 5.4" />
            break;
        case "tag":        @* Kategorijos *@
            <path d="M3.5 12V4.5a1 1 0 0 1 1-1H12l8.5 8.5-8.5 8.5z" />
            <circle cx="8" cy="8" r="1.4" />
            break;
        case "pencil":
            <path d="M4 20h4L19 9l-4-4L4 16zM13.5 6.5l4 4" />
            break;
        case "trash":
            <path d="M4.5 7h15M9.5 7V4.5h5V7M6.5 7l1 13h9l1-13M10 11v5.5M14 11v5.5" />
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public int Size { get; set; } = 18;
}
